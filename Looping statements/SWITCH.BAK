#include<stdio.h>
#include<conio.h>
void main()
{
   int a,b,ch;
   clrscr();
   printf("Enter the a,b values");
   scanf("%d%d",&a,&b);
   printf("Enter ur choice");
   scanf("%d",&ch);
   switch(ch)
   {
	case 1:
		printf("Addition is %d",a+b);
		break;
	case 2:
		printf("Subraction is %d",a-b);
		break;
	case 3:
		printf("Multiplication is %d",a*b);
		break;
	case 4:
		printf("Division is %d",a/b);
		break;
	default:
		printf("Please enter correct choice");
   }
   getch();
}
