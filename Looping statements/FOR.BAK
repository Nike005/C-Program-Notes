/*For statement:
  -------------
	If we want to execute a continuous condition we use for statement.
The for statement contains initialization ,test condition, increment or
decrement.

Syntax:
	for(initialization;test condition; incr/decr)

*/

#include<stdio.h>
#include<conio.h>
void main()
{
int i,n;
clrscr();
printf("Enter your range:");
scanf("%d",&n);
for(i=1;i<=n;i++)
{
printf("%d\n",i);
}
getch();
}



