//*****************************************************

 void main()
 {
  int i=0,n;
  clrscr();
  printf("Enter the n val:");
  scanf("%d",&n);
  while(i<=n)
  {
   printf("The i val is:%d\n",i);
   i++;
  }
  getch();
 }







