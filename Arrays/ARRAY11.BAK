 /*   ONE DIMENSIONAL ARRAY DECLARATION*/
	#include<stdio.h>
	#include<conio.h>
	void main()
	{
	int a[5],i;
	clrscr();
	printf("Enter the 5 values");
	for(i=0;i<=5;i++)
	{
	scanf("%d",&a[i]);
	}
	printf("\n The values are\n");
	for(i=0;i<=5;i++)
	{
	printf("%d\t",a[i]);
	}
	getch();
	}


