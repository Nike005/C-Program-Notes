       /*Initialization
	--------------
		When we assign a value to a variable then it known as
	initialization.
	Syntax:
		data_type var_name=value;
	Ex:
		int a=10;*/

	#include<stdio.h>
	#include<conio.h>
	void main()
	{
	 int a=10;
	 float b=10.43;
	 char s[10]="computer";
	 char c='j';
	 clrscr();
	 printf("Output\n");   //  \n - New line character
	 printf("~~~~~~~\n\n\n\n");
	 printf("The int val is :%d\n",a);
	 printf("The float val is :%.2f\n",b);
	 printf("The string is :%s\n",s);
	 printf("The char is :%c",c);
	 getch();
	}

