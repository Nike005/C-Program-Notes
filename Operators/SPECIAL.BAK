	//Sizeof() operator:

	#include<stdio.h>
	#include<conio.h>
	void main()
	{
	 int a=10;
	 float b=10.00;
	 char c='1';
	 char m[45]="asfaf";
	 clrscr();
	 printf("The size of integer is %d\n",sizeof(a));
	 printf("The size of float is %d\n",sizeof(b));
	 printf("The size of char is %d\n",sizeof(c));
	 printf("the size of string is %d",sizeof(m));
	 getch();
	}

/* int - 2 bytes
   float - 4 bytes
   char - 1 byte
*/