//Increment and Decrement Operators:
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#include<stdio.h>
#include<conio.h>
void main()
{
int i=5;
clrscr();
printf("%d\n",i);   //5
printf("%d\n",i--); //5      //post decrement
printf("%d\n",i);   //4
printf("%d\n",--i); //3     // predecrement
printf("%d\n",++i); //4     //preincrement
printf("%d\n",i++); //4    //post increment
printf("%d\n",i);   //5
getch();
}








